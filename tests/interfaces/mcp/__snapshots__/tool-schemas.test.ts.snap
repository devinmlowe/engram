exports[`generated tool schemas (#119) > commitments matches the recorded contract 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Commitments",
  },
  "description": "List tracked commitments — first-person promises, intentions and follow-ups owed by others, extracted nightly from conversations ("mention once, never dropped"). Default: pending items, overdue first, then by due date, then newest. Use include_due_within_days to surface only what is due soon or overdue.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "budget": {
        "default": 1500,
        "description": "Token budget for the XML response",
        "maximum": 10000,
        "minimum": 100,
        "type": "integer",
      },
      "include_due_within_days": {
        "description": "Only items with a due date within this many days (overdue items included)",
        "maximum": 3650,
        "minimum": 0,
        "type": "number",
      },
      "limit": {
        "default": 20,
        "description": "Max items",
        "maximum": 500,
        "minimum": 1,
        "type": "integer",
      },
      "read_scopes": {
        "description": "Explicit scopes to read from (e.g. ["global", "hermes:career"]). Overrides ENGRAM_READ_SCOPES for this call only (#25).",
        "items": {
          "minLength": 1,
          "type": "string",
        },
        "minItems": 1,
        "type": "array",
      },
      "scope": {
        "description": "Tenant identity for this call (e.g. "hermes:career"); derives the read default global + own",
        "minLength": 1,
        "type": "string",
      },
      "status": {
        "default": "pending",
        "description": "Lifecycle state to list",
        "enum": [
          "pending",
          "done",
          "dropped",
          "superseded",
          "all",
        ],
        "type": "string",
      },
    },
    "type": "object",
  },
  "name": "commitments",
}
`;

