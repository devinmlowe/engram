        "minimum": 0,
        "type": "integer",
      },
      "deduplicate_overlaps": {
        "default": true,
        "description": "Merge overlapping context windows to avoid duplicate lines",
        "type": "boolean",
      },
      "group_by": {
        "default": "location",
        "description": "Order results by file location or grouped by pattern",
        "enum": [
          "pattern",
          "location",
        ],
        "type": "string",
      },
      "max_matches": {
        "default": 100,
        "description": "Maximum matches to return (1-500)",
        "maximum": 500,
