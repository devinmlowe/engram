exports[`generated tool schemas (#119) > remember matches the recorded contract 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
    "title": "Remember",
  },
  "description": "Store a fact, preference, decision, or other knowledge as a semantic memory. Use this to explicitly record important information that should persist across conversations. Automatically deduplicates against existing memories.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "content": {
        "description": "The fact, preference, or knowledge to remember",
        "minLength": 1,
        "type": "string",
      },
      "context": {
        "description": "Provenance note stored alongside the memory (e.g. what produced this write)",
        "maxLength": 500,
        "type": "string",
      },
      "importance": {
        "default": 0.7,
        "description": "Importance score (0-1)",
        "maximum": 1,
        "minimum": 0,
        "type": "number",
