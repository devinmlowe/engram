        "description": "Starting entity name (e.g., 'TypeScript', 'engram', 'SQLite')",
        "minLength": 1,
        "type": "string",
      },
      "max_depth": {
        "default": 3,
        "description": "Maximum traversal depth (1-5)",
        "maximum": 5,
        "minimum": 1,
        "type": "integer",
      },
      "max_nodes": {
        "default": 50,
        "description": "Safety cap on total nodes returned (1-50)",
        "maximum": 50,
        "minimum": 1,
        "type": "integer",
      },
      "read_scopes": {
        "description": "Explicit scopes to read from (e.g. ["global", "hermes:career"]). Overrides ENGRAM_READ_SCOPES for this call only (#25).",
        "items": {
          "minLength": 1,
          "type": "string",
        },
        "minItems": 1,
        "type": "array",
      },
      "relationship_types": {
        "description": "Filter by relationship types",
        "items": {
          "enum": [
            "uses",
            "depends_on",
            "related_to",
            "part_of",
            "configured_by",
            "solved_by",
            "contains",
          ],
          "type": "string",
        },
        "type": "array",
      },
      "scope": {
        "description": "Tenant identity for this call (e.g. "hermes:career"); derives the read default global + own",
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "entity",
      "criteria",
    ],
    "type": "object",
  },
  "name": "explore_selective",
}
`;

