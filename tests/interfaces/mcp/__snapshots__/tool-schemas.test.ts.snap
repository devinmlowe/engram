exports[`generated tool schemas (#119) > ingest_turn matches the recorded contract 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false,
    "title": "Ingest Turn",
  },
  "description": "Record one user/assistant turn of an external agent conversation (e.g. a Hermes profile) in engram's episodic layer so it becomes searchable and feeds the nightly dream extraction. Idempotent: re-sending the same session_id + turn_index updates the turn in place. The conversation carries the given tenant scope, and every memory later extracted from it inherits that scope. An optional author {id, name, is_bot} is stored on the turn.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "assistant_text": {
        "description": "The assistant's reply for this turn",
        "type": "string",
      },
      "author": {
        "additionalProperties": false,
        "description": "Who authored the user side of the turn (stored as JSON on the exchange)",
        "properties": {
          "id": {
            "description": "Platform user id",
            "type": "string",
          },
          "is_bot": {
            "description": "True when the author is a bot",
            "type": "boolean",
          },
          "name": {
            "description": "Display name",
            "type": "string",
          },
        },
        "type": "object",
      },
      "scope": {
        "description": "Tenant scope of the conversation (e.g. "hermes:career")",
        "minLength": 1,
        "type": "string",
      },
      "session_id": {
        "description": "Caller's conversation/session identifier (stable across turns)",
        "minLength": 1,
        "type": "string",
      },
      "source": {
        "default": "hermes",
        "description": "Platform/source label; part of the conversation key (default "hermes")",
        "minLength": 1,
        "type": "string",
      },
      "timestamp": {
        "description": "ISO-8601 time of the turn (default: now)",
        "type": "string",
      },
      "tool_calls": {
        "description": "Tools invoked during the turn (input/output are truncated to 1000 chars)",
        "items": {
          "properties": {
            "input": {
              "description": "Tool input (any JSON)",
            },
            "name": {
              "minLength": 1,
              "type": "string",
            },
            "output": {
              "description": "Tool output/result summary (any JSON)",
            },
          },
          "required": [
            "name",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "turn_index": {
        "description": "0-based position of this turn within the session",
        "minimum": 0,
        "type": "integer",
      },
      "user_text": {
        "description": "The user's message for this turn",
        "type": "string",
      },
    },
    "required": [
      "session_id",
      "turn_index",
      "scope",
      "user_text",
      "assistant_text",
    ],
    "type": "object",
  },
  "name": "ingest_turn",
}
`;

exports[`generated tool schemas (#119) > recall matches the recorded contract 1`] = `
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Recall Memories",
  },
  "description": "Retrieve relevant memories from past Claude Code conversations and extracted knowledge. Uses hybrid semantic + keyword search with token-budgeted output across episodic and semantic memory stores. Search BEFORE every task to recover decisions, solutions, and context. Time-scope with after/before (YYYY-MM-DD) or a natural-language dateHint ("last week", "in March", "this day last year", "on this day"); dateBasis picks whether dates mean when a memory was filed or when the events it describes happened. The applied window is echoed in <date_filter>. Retrieval records access bookkeeping on the returned memories (access_count, last_accessed, stability); pass reinforce: false to opt out.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "after": {
        "description": "Only results after this date (YYYY-MM-DD)",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string",
      },
      "before": {
        "description": "Only results before this date (YYYY-MM-DD; that day is excluded)",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string",
      },
      "budget": {
        "default": 1500,
        "description": "Max tokens in response",
        "maximum": 5000,
        "minimum": 100,
        "type": "integer",
      },
      "dateBasis": {
        "default": "filed",
        "description": "What the dates refer to: 'filed' = when the memory was recorded (memories IN March); 'event' = when the described events happened, via source-exchange timestamps (memories ABOUT March). Episodic results are identical under both.",
        "enum": [
          "filed",
          "event",
        ],
        "type": "string",
      },
      "dateHint": {
        "description": "Natural-language date window, resolved in UTC: today, yesterday, this/last week|month|year, N days|weeks|months ago, this day last year, in <month>, <month> <year>, since <phrase>, before <phrase>, on this day (same month/day across all years), or an ISO date/month. Explicit after/before take precedence over the hint. Unrecognized hints apply no filter and are reported in <date_filter note>.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
      "depth": {
        "default": "shallow",
        "enum": [
          "shallow",
          "deep",
        ],
        "type": "string",
      },
      "query": {
        "minLength": 2,
        "type": "string",
      },
      "read_scopes": {
        "description": "Explicit scopes to read from (e.g. ["global", "hermes:career"]). Overrides ENGRAM_READ_SCOPES for this call only.",
        "items": {
          "minLength": 1,
          "type": "string",
        },
        "minItems": 1,
        "type": "array",
      },
      "reinforce": {
        "default": true,
        "description": "Reinforce the semantic memories this call returns (FSRS: bumps access_count/last_accessed and grows stability). Set false for read-only or diagnostic callers that must not mutate the store.",
        "type": "boolean",
      },
      "scope": {
        "description": "Tenant identity for this call (e.g. "hermes:career"); reads default to global + this scope. Overrides ENGRAM_SCOPE for this call only.",
        "minLength": 1,
        "type": "string",
      },
      "sources": {
        "default": [
          "episodic",
          "semantic",
        ],
        "description": "Which memory stores to search. Defaults to episodic and semantic.",
        "items": {
          "enum": [
            "episodic",
            "semantic",
            "graph",
          ],
          "type": "string",
        },
        "type": "array",
      },
    },
    "required": [
      "query",
    ],
    "type": "object",
  },
  "name": "recall",
}
`;

exports[`generated tool schemas (#119) > recall_drill matches the recorded contract 1`] = `
