        "type": "boolean",
      },
      "result_index": {
        "description": "0-based index into session results",
        "minimum": 0,
        "type": "integer",
      },
      "session_id": {
        "description": "Session ID from recall_session",
        "format": "uuid",
        "type": "string",
      },
    },
    "required": [
      "session_id",
      "result_index",
    ],
    "type": "object",
  },
  "name": "recall_drill",
}
`;

