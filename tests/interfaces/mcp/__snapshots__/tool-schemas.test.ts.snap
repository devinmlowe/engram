    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Selective Graph Exploration",
  },
  "description": "Explore the knowledge graph selectively by expanding only branches relevant to specified criteria. Unlike explore (fixed-depth BFS), this uses embedding similarity to prune irrelevant neighbors and recursively follows only relevant paths. Use when you want to find connections related to a specific topic or question.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "criteria": {
        "description": "What makes a neighbor relevant (e.g., 'build tooling', 'performance optimization')",
