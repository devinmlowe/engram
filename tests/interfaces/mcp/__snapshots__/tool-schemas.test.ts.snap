{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Explore Knowledge Graph",
  },
  "description": "Explore connections in the knowledge graph starting from an entity. Shows what a concept, tool, project, or technology is connected to. Use after recall to understand how things relate to each other.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "budget": {
        "default": 1500,
        "description": "Max tokens in response",
        "maximum": 5000,
        "minimum": 100,
        "type": "integer",
      },
      "depth": {
        "default": 1,
        "description": "Number of hops to traverse (1-3)",
        "maximum": 3,
        "minimum": 1,
        "type": "integer",
      },
      "entity": {
        "description": "Entity name to explore (e.g., 'TypeScript', 'engram', 'SQLite')",
        "minLength": 1,
        "type": "string",
      },
      "limit": {
        "default": 25,
        "description": "Max neighbors to return, sorted by weight (1-50)",
        "maximum": 50,
        "minimum": 1,
        "type": "integer",
      },
      "read_scopes": {
        "description": "Explicit scopes to read from (e.g. ["global", "hermes:career"]). Overrides ENGRAM_READ_SCOPES for this call only (#25).",
