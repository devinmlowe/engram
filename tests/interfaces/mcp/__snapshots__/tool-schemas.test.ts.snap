exports[`generated tool schemas (#119) > forget matches the recorded contract 1`] = `
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
    "title": "Forget Memory",
  },
  "description": "Remove a memory the user says is wrong or stale. Pass the memory_id from a recall result (<semantic id="…">) to forget it in one call. Pass query instead to search for candidates: the tool returns matching memories with their ids and forgets nothing unless confirm is true AND exactly one memory matches (a single result, or a single result whose content equals the query). The memory is soft-deleted (kept for ENGRAM_FORGET_RETENTION_DAYS, then purged by the dream pipeline), drops out of every recall path immediately, is logged in the change log with this client's name, and will not be re-extracted from the same conversation. hard: true deletes it outright. Only memories within read_scopes can be forgotten unless scope is "global".",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "confirm": {
        "default": false,
        "description": "In query mode: forget the match when exactly one memory matches",
        "type": "boolean",
      },
      "hard": {
        "default": false,
        "description": "Delete the row outright instead of the soft delete + retention purge",
        "type": "boolean",
      },
      "memory_id": {
        "description": "Id of the memory to forget (from recall's <semantic id>), or a unique prefix of 6+ characters",
        "minLength": 6,
        "type": "string",
      },
      "query": {
        "description": "Find candidate memories instead of naming one; returns ids, deletes nothing unless confirm + a single match",
        "minLength": 2,
        "type": "string",
      },
      "read_scopes": {
        "description": "Scopes this call may act on (e.g. ["global", "hermes:career"]). Overrides ENGRAM_READ_SCOPES for this call only.",
        "items": {
          "minLength": 1,
          "type": "string",
        },
        "minItems": 1,
        "type": "array",
      },
      "scope": {
        "description": "Tenant identity for this call (e.g. "hermes:career"); reads default to global + this scope. "global" acts on a memory in any scope.",
        "minLength": 1,
        "type": "string",
      },
    },
    "type": "object",
  },
  "name": "forget",
}
`;

