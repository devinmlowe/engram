# Engram nightly dream consolidation — systemd *user* service template.
#
# Rendered by scripts/install-daemon.sh on Linux: the placeholders below are
# substituted with the resolved checkout, node binary, and log directory, then
# the unit is written to ${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/.
# Do not install this file verbatim; unresolved placeholders will fail.
#
# Mirrors launchd/com.engram.dreamstate.plist: same command line, same
# environment, same log files, same background priority.

[Unit]
Description=Engram nightly dream consolidation
Documentation=https://github.com/devinmlowe/engram
After=network-online.target
Wants=network-online.target
# Same one-hour re-run throttle the launchd agent uses (ThrottleInterval).
StartLimitIntervalSec=3600
StartLimitBurst=1

[Service]
Type=oneshot
WorkingDirectory=__ENGRAM_DIR__
ExecStart=__NODE_BIN__ --max-old-space-size=2048 dist/interfaces/cli/index.js dream

Environment=NODE_ENV=production
# Optional provider keys (ANTHROPIC_API_KEY, OPENROUTER_API_KEY, ENGRAM_LOCAL_MODEL)
# are written here by the installer when present in its environment. The leading
# "-" makes the file optional so the service still runs without one.
EnvironmentFile=-%h/.local/share/engram/dream.env

StandardOutput=append:__LOG_DIR__/dream.log
StandardError=append:__LOG_DIR__/dream-error.log

Nice=10
# Consolidation is bursty; keep it from starving interactive work.
IOSchedulingClass=idle
