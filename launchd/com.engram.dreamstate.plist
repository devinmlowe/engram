<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.engram.dreamstate</string>

    <!-- The launcher sources ${XDG_CONFIG_HOME:-~/.config}/engram/env (mode 600)
         for API keys and settings, then execs NODE_BIN on the built CLI.
         No secrets belong in this file. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ENGRAM_DIR__/scripts/run-dream.sh</string>
        <string>--daemon</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ENGRAM_DIR__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>NODE_BIN</key>
        <string>__NODE_BIN__</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/dream.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/dream-error.log</string>

    <key>Nice</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>ThrottleInterval</key>
    <integer>3600</integer>

    <key>AbandonProcessGroup</key>
    <false/>
</dict>
</plist>
