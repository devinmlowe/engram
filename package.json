{
  "name": "engram",
  "version": "0.1.0",
  "description": "Cognitive memory system for Claude Code — episodic storage, semantic extraction, knowledge graph, and dream-state consolidation",
  "type": "module",
  "main": "dist/interfaces/cli/index.js",
  "bin": {
    "engram": "dist/interfaces/cli/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "launchd",
    ".claude-plugin",
    ".mcp.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/interfaces/cli/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "mcp": "tsx src/interfaces/mcp/server.ts",
    "dream": "tsx src/interfaces/cli/index.ts dream",
    "migrate": "tsx src/interfaces/cli/index.ts migrate",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "memory",
    "episodic",
    "semantic",
    "knowledge-graph",
    "mcp",
    "rag"
  ],
  "author": "Devin Lowe",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-metrics": "^2.4.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
