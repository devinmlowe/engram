{
  "name": "@devinmlowe/engram",
  "version": "0.3.0",
  "description": "Cognitive memory system for Claude Code — episodic storage, semantic extraction, knowledge graph, and dream-state consolidation",
  "mcpName": "io.github.devinmlowe/engram",
  "type": "module",
  "main": "dist/interfaces/cli/index.js",
  "bin": {
    "engram": "dist/interfaces/cli/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "launchd",
    ".claude-plugin",
    ".mcp.json",
    "commands",
    "server.json",
    "scripts/preflight.cjs",
    "scripts/sync-manifests.cjs",
    "scripts/install-mcp-daemon.sh",
    "scripts/install-mcp-daemon.ps1",
    "scripts/install-daemon.sh",
    "scripts/install-daemon.ps1",
    "scripts/install-visualizer.sh",
    "scripts/install-visualizer.ps1",
    "scripts/run-mcp-daemon.sh",
    "scripts/run-mcp-daemon.ps1",
    "scripts/run-dream.sh",
    "scripts/run-visualizer.ps1",
    "systemd",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run test:run",
    "postinstall": "node scripts/preflight.cjs",
    "version": "node scripts/sync-manifests.cjs && git add .claude-plugin/plugin.json .claude-plugin/marketplace.json server.json",
    "sync-manifests": "node scripts/sync-manifests.cjs",
    "check-manifests": "node scripts/sync-manifests.cjs --check",
    "dev": "tsx src/interfaces/cli/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "mcp": "tsx src/interfaces/mcp/server.ts",
    "dream": "tsx src/interfaces/cli/index.ts dream",
    "migrate": "tsx src/interfaces/cli/index.ts migrate",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "memory",
    "episodic",
    "semantic",
    "knowledge-graph",
    "mcp",
    "rag"
  ],
  "author": "Devin Lowe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devinmlowe/engram.git"
  },
  "homepage": "https://github.com/devinmlowe/engram#readme",
  "bugs": {
    "url": "https://github.com/devinmlowe/engram/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-metrics": "^2.4.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "zod": "^4.3.6"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
